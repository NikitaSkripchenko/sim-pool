#!/usr/bin/env python3
"""Steer known simulator tool calls through Sim Pool."""

import argparse
import json
import os
from pathlib import Path, PurePath
import re
import shlex
import sys
import uuid

SIMCTL_ACTIONS = {
    "boot", "bootstatus", "create", "clone", "delete", "erase", "shutdown",
    "install", "uninstall", "launch", "terminate", "spawn",
}
MCP_ACTIONS = {
    "batch", "test_sim", "build_run_sim", "boot_sim", "shutdown_sim", "erase_sims",
    "create_sim", "clone_sim", "delete_sim", "rename_sim",
}
MCP_LEASE_ACTIONS = {
    "launch_app_sim", "install_app_sim", "debug_attach_sim", "open_sim", "stop_app_sim",
    "tap", "swipe", "screenshot", "snapshot_ui", "type_text", "button", "gesture",
    "drag", "key_press", "key_sequence", "long_press", "record_sim_video",

}
CLAUDE_ADMIN_ACTIONS = {"create", "clone", "delete", "erase", "shutdown", "reset", "rename"}
ASSIGNMENT = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_]*=")
SEPARATORS = frozenset(";&|()")


def is_simulator_command(words):
    while words and (ASSIGNMENT.match(words[0]) or PurePath(words[0]).name in {"env", "command", "exec", "time", "noglob"}):
        words = words[1:]
    if not words:
        return False
    program, *args = words
    program = PurePath(program).name
    if program == "xcrun":
        for index, argument in enumerate(args):
            if argument in {"simctl", "xcodebuild"}:
                program, args = argument, args[index + 1:]
                break
    if program == "sim-pool" and args and args[0] in {"init", "add", "prune"}:
        return True
    if program == "xcodebuild":
        values = iter(args)
        for arg in values:
            if arg in {"-scheme", "-project", "-workspace", "-target", "-configuration", "-destination"}:
                next(values, None)
            elif arg in {"test", "test-without-building"}:
                return True
        return False
    if program == "simctl":
        while args and args[0].split("=", 1)[0] in {"--set", "--profiles"}:
            args = args[1:] if "=" in args[0] else args[2:]
        return bool(args and args[0] in SIMCTL_ACTIONS)
    return False


def blocks_shell(command):
    for line in command.splitlines():
        lexer = shlex.shlex(line, posix=True, punctuation_chars=";&|()")
        lexer.whitespace_split = True
        try:
            tokens = list(lexer)
        except ValueError:
            continue
        words = []
        for token in [*tokens, ";"]:
            if token and all(char in SEPARATORS for char in token):
                if is_simulator_command(words):
                    return True
                words = []
            else:
                words.append(token)
    return False


def interactive_lease(device):
    try:
        udid = str(uuid.UUID(device)).upper()
        home = Path(os.environ.get("SIM_POOL_HOME", "~/Library/Application Support/sim-pool")).expanduser()
        lease = json.loads((home / "pool.json").read_text())["leases"].get(udid, {})
        if not (lease.get("interactive") and lease.get("ready") and not lease.get("blocked")):
            return False
        os.kill(lease["owner"], 0)
        return True
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return False


def blocks(event):
    name = event.get("tool_name", "").lower()
    inputs = event.get("tool_input") or {}
    if name in {"bash", "exec_command"}:
        return blocks_shell(inputs.get("command", inputs.get("cmd", "")))
    if name == "mcp__claude_code_ios_simulator__control":
        action = inputs.get("action")
        if action in {"list", "status", "devices", "list_devices"}:
            return False
        device = inputs.get("device")
        return action in CLAUDE_ADMIN_ACTIONS or not interactive_lease(device)
    server, _, action = name.removeprefix("mcp__").partition("__")
    if server in {"xcodebuildmcp", "mobilebuildmcp"}:
        return action in MCP_ACTIONS or (action in MCP_LEASE_ACTIONS
                                        and not interactive_lease(inputs.get("simulatorId")))
    return False


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    # Accept old installed command lines until the user reruns the installer.
    parser.add_argument("--interactive-device", action="append", help=argparse.SUPPRESS)
    parser.parse_args()
    if blocks(json.load(sys.stdin)):
        print("Use sim-pool test for XCTest and sim-pool status for capacity. "
              "For interactive work start sim-pool hold [UDID] and pass the leased UDID. "
              "Use Terminal for simulator administration.", file=sys.stderr)
        sys.exit(2)
